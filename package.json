{
  "name": "the-show-fhm",
  "productName": "The Show: Franchise Hockey Manager",
  "version": "0.0.1",
  "description": "The Show: Franchise Hockey Manager — single-player hockey management simulation (Football Manager / EHM spirit).",
  "author": "max",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "app": "electron-vite build && electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:snap": "electron-vite build && node scripts/dev/ui-snapshot.mjs",
    "autopilot": "AP_RUN=1 npx vitest run src/engine/career/autopilot/run.harness.test.ts --no-file-parallelism",
    "autopilot:watch": "node scripts/dev/autopilot-watch.mjs",
    "autopilot:dashboard": "node scripts/dev/autopilot-dashboard.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.104.1",
    "electron-updater": "6.3.9",
    "kokoro-js": "1.2.1",
    "pixi.js": "8.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.184.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.4.0",
    "electron-builder": "25.1.8",
    "electron-vite": "5.0.0",
    "playwright-core": "1.61.1",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "4.1.8"
  },
  "optionalDependencies": {
    "node-llama-cpp": "3.19.0"
  }
}
